FROM spark:3.5.7-java17-python3

# Install python liberies
USER root
RUN pip install --no-cache-dir mlflow boto3 pyspark==3.5.2

RUN export MLFLOW_TRACKING_URI=http://mlflow:5000

CMD ["mlflow", "models", "serve", "--model-uri", "models:/titanic-logreg/4", "--host", "0.0.0.0", "--port", "1234", "--env-manager", "local"]